<Project Sdk="Microsoft.NET.Sdk">
	<!-- RA2 mod code integrated for the Android port. Mirrors the in-repo project
	     layout used by OpenRA.Mods.Cnc (Directory.Build.props applies automatically;
	     the external-engine import from the upstream OpenRA2 repository is not
	     needed here because the engine lives in this repository). Desktop builds
	     keep the net8.0 default; Android builds multi-target via BuildForAndroid,
	     exactly like the other mod assemblies. -->
	<PropertyGroup Condition="'$(BuildForAndroid)' == 'true'">
		<TargetFramework></TargetFramework>
		<TargetFrameworks>net9.0-android</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj">
			<Private>False</Private>
		</ProjectReference>
		<ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj">
			<Private>False</Private>
		</ProjectReference>
		<ProjectReference Include="..\OpenRA.Mods.Cnc\OpenRA.Mods.Cnc.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>
</Project>
